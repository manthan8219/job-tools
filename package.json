{
  "name": "job-applier-mcp",
  "version": "0.1.0",
  "description": "MCP Server for job application workflows",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "job-applier-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vitest run && tsc",
    "watch": "tsc --watch",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "job-applier"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@mastra/core": "^1.66.0",
    "@mastra/mcp": "^1.17.3",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "md-to-pdf": "^5.2.5",
    "mongodb": "^7.6.0",
    "node-latex": "^3.1.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-openidconnect": "^0.1.2",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/passport-openidconnect": "^0.1.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vercel": "^59.16.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "puppeteer": "22.15.0"
  }
}
