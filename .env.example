# PostgreSQL Connection (used for structured data: Auth, Applications, Users)
DATABASE_URL="postgresql://user:password@localhost:5432/job_applier"

# MongoDB Connection (used for unstructured data: Resumes, Scraped Jobs, Vector Search)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority"
MONGODB_DB_NAME="job_applier_db"

# JWT Secret for local user authentication
JWT_SECRET="your-super-secret-jwt-key"

# Redis Connection (used for caching, session state, onboarding TTL)
REDIS_URL="redis://localhost:6379"

# Embedding API Keys (e.g., if you use OpenAI for the 1536-dimension vectors)
OPENAI_API_KEY="sk-..."
